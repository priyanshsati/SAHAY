
#include <iostream>
#include <string>
using namespace std;

class Person {
protected:
    string name;
    int age;
    string phone;

public:
    Person(string n, int a, string p) {
        name = n;
        age = a;
        phone = p;
    }

    void displayPerson() {
        cout << "Name: " << name << endl;
        cout << "Age: " << age << endl;
        cout << "Phone: " << phone << endl;
    }
};

class Victim : public Person {
private:
    int victimID;
    string injuryStatus;
    int priority;

public:
    Victim(int id, string n, int a, string p,
           string injury, int pr) : Person(n, a, p) {
        victimID = id;
        injuryStatus = injury;
        priority = pr;
    }

    void displayVictim() {
        cout << "\nVictim Details\n";
        cout << "Victim ID: " << victimID << endl;
        displayPerson();
        cout << "Injury: " << injuryStatus << endl;
        cout << "Priority: " << priority << endl;
    }
};

class Rescuer : public Person {
private:
    int rescuerID;
    string team;
    string location;
    bool available;

public:
    Rescuer(int id, string n, int a, string p,
            string t, string l, bool av) : Person(n, a, p) {
        rescuerID = id;
        team = t;
        location = l;
        available = av;
    }

    void displayRescuer() {
        cout << "\nRescuer Details\n";
        cout << "Rescuer ID: " << rescuerID << endl;
        displayPerson();
        cout << "Team: " << team << endl;
        cout << "Location: " << location << endl;
        cout << "Available: " << (available ? "Yes" : "No") << endl;
    }
};

class Disaster {
protected:
    int disasterID;
    string type;
    string location;
    int severity;

public:
    Disaster(int id, string t, string l, int s) {
        disasterID = id;
        type = t;
        location = l;
        severity = s;
    }

    void displayDisaster() {
        cout << "\nDisaster Details\n";
        cout << "ID: " << disasterID << endl;
        cout << "Type: " << type << endl;
        cout << "Location: " << location << endl;
        cout << "Severity: " << severity << "/10" << endl;
    }
};

class Flood : public Disaster {
private:
    float waterLevel;
    float rainfall;

public:
    Flood(int id, string l, int s, float w, float r)
        : Disaster(id, "Flood", l, s) {
        waterLevel = w;
        rainfall = r;
    }

    void displayFlood() {
        displayDisaster();
        cout << "Water Level: " << waterLevel << " metres" << endl;
        cout << "Rainfall: " << rainfall << " mm" << endl;
    }
};

class Earthquake : public Disaster {
private:
    float magnitude;
    float depth;

public:
    Earthquake(int id, string l, int s, float m, float d)
        : Disaster(id, "Earthquake", l, s) {
        magnitude = m;
        depth = d;
    }

    void displayEarthquake() {
        displayDisaster();
        cout << "Magnitude: " << magnitude << endl;
        cout << "Depth: " << depth << " km" << endl;
    }
};

class Location {
private:
    int locationID;
    string name;
    double latitude, longitude;

public:
    Location(int id, string n, double lat, double lon) {
        locationID = id;
        name = n;
        latitude = lat;
        longitude = lon;
    }

    void displayLocation() {
        cout << "\nLocation Details\n";
        cout << "ID: " << locationID << endl;
        cout << "Name: " << name << endl;
        cout << "Latitude: " << latitude << endl;
        cout << "Longitude: " << longitude << endl;
    }
};

class Node {
private:
    int nodeID;
    string name;

public:
    Node(int id, string n) {
        nodeID = id;
        name = n;
    }

    int getNodeID() {
        return nodeID;
    }

    void displayNode() {
        cout << "Node ID: " << nodeID
             << ", Name: " << name << endl;
    }
};

class Road {
private:
    int roadID;
    Node* startNode;
    Node* endNode;
    double distance;
    bool blocked;

public:
    Road(int id, Node* start, Node* end, double d, bool b) {
        roadID = id;
        startNode = start;
        endNode = end;
        distance = d;
        blocked = b;
    }

    void displayRoad() {
        cout << "\nRoad Details\n";
        cout << "Road ID: " << roadID << endl;
        cout << "From Node: " << startNode->getNodeID() << endl;
        cout << "To Node: " << endNode->getNodeID() << endl;
        cout << "Distance: " << distance << " km" << endl;
        cout << "Status: " << (blocked ? "Blocked" : "Open") << endl;
    }
};

class Graph {
private:
    string cityName;
    int numberOfNodes;

public:
    Graph(string city, int nodes) {
        cityName = city;
        numberOfNodes = nodes;
    }

    void displayGraph() {
        cout << "\nGraph Details\n";
        cout << "City: " << cityName << endl;
        cout << "Total Nodes: " << numberOfNodes << endl;
    }

    void addNode() {
        numberOfNodes++;
        cout << "Node added. Total nodes: "
             << numberOfNodes << endl;
    }
};

class Route {
private:
    int routeID;
    string source, destination;
    double distance, estimatedTime;
    int safetyScore;

public:
    Route(int id, string s, string d, double dist,
          double time, int safety) {
        routeID = id;
        source = s;
        destination = d;
        distance = dist;
        estimatedTime = time;
        safetyScore = safety;
    }

    void displayRoute() {
        cout << "\nRoute Details\n";
        cout << "Route ID: " << routeID << endl;
        cout << "Source: " << source << endl;
        cout << "Destination: " << destination << endl;
        cout << "Distance: " << distance << " km" << endl;
        cout << "Estimated Time: " << estimatedTime << " minutes" << endl;
        cout << "Safety Score: " << safetyScore << "/100" << endl;
    }
};

class RouteCalculator {
private:
    string algorithm;

public:
    RouteCalculator(string algo) {
        algorithm = algo;
    }

    void displayCalculator() {
        cout << "\nAlgorithm: " << algorithm << endl;
    }

    void calculateRoute() {
        cout << "Calculating route using "
             << algorithm << "..." << endl;
    }
};

class Shelter {
private:
    int shelterID;
    string name, location;
    int capacity, availableSpace;

public:
    Shelter(int id, string n, string l, int c, int a) {
        shelterID = id;
        name = n;
        location = l;
        capacity = c;
        availableSpace = a;
    }

    void displayShelter() {
        cout << "\nShelter Details\n";
        cout << "ID: " << shelterID << endl;
        cout << "Name: " << name << endl;
        cout << "Location: " << location << endl;
        cout << "Capacity: " << capacity << endl;
        cout << "Available Space: " << availableSpace << endl;
    }
};

class Hospital {
private:
    int hospitalID;
    string name, location;
    int bedsAvailable, emergencyCapacity;

public:
    Hospital(int id, string n, string l, int beds, int emergency) {
        hospitalID = id;
        name = n;
        location = l;
        bedsAvailable = beds;
        emergencyCapacity = emergency;
    }

    void displayHospital() {
        cout << "\nHospital Details\n";
        cout << "ID: " << hospitalID << endl;
        cout << "Name: " << name << endl;
        cout << "Location: " << location << endl;
        cout << "Beds Available: " << bedsAvailable << endl;
        cout << "Emergency Capacity: " << emergencyCapacity << endl;
    }
};

class Ambulance {
private:
    int ambulanceID;
    string driver, location;
    bool available;
    int fuelLevel;

public:
    Ambulance(int id, string d, string l, bool a, int fuel) {
        ambulanceID = id;
        driver = d;
        location = l;
        available = a;
        fuelLevel = fuel;
    }

    void displayAmbulance() {
        cout << "\nAmbulance Details\n";
        cout << "ID: " << ambulanceID << endl;
        cout << "Driver: " << driver << endl;
        cout << "Location: " << location << endl;
        cout << "Available: " << (available ? "Yes" : "No") << endl;
        cout << "Fuel Level: " << fuelLevel << "%" << endl;
    }
};

class EmergencyRequest {
private:
    int requestID;
    string requester, location, emergencyType, status;
    int priority;

public:
    EmergencyRequest(int id, string r, string l,
                     string type, int p, string s) {
        requestID = id;
        requester = r;
        location = l;
        emergencyType = type;
        priority = p;
        status = s;
    }

    void displayRequest() {
        cout << "\nEmergency Request\n";
        cout << "Request ID: " << requestID << endl;
        cout << "Requester: " << requester << endl;
        cout << "Location: " << location << endl;
        cout << "Emergency Type: " << emergencyType << endl;
        cout << "Priority: " << priority << endl;
        cout << "Status: " << status << endl;
    }
};

class RescueOperation {
private:
    int operationID;
    string location, assignedTeam, status;
    int priority;

public:
    RescueOperation(int id, string l, string team,
                    int p, string s) {
        operationID = id;
        location = l;
        assignedTeam = team;
        priority = p;
        status = s;
    }

    void displayOperation() {
        cout << "\nRescue Operation\n";
        cout << "Operation ID: " << operationID << endl;
        cout << "Location: " << location << endl;
        cout << "Assigned Team: " << assignedTeam << endl;
        cout << "Priority: " << priority << endl;
        cout << "Status: " << status << endl;
    }
};

class Resource {
private:
    int resourceID;
    string name, type, location;
    int quantity;

public:
    Resource(int id, string n, string t, int q, string l) {
        resourceID = id;
        name = n;
        type = t;
        quantity = q;
        location = l;
    }

    void displayResource() {
        cout << "\nResource Details\n";
        cout << "Resource ID: " << resourceID << endl;
        cout << "Name: " << name << endl;
        cout << "Type: " << type << endl;
        cout << "Quantity: " << quantity << endl;
        cout << "Location: " << location << endl;
    }
};

int main() {
    Person p1("Lovkesh", 20, "9876543210");

    Victim v1(101, "Vikas", 30, "9876500001",
              "Injured", 1);

    Rescuer r1(201, "Shailesh", 28, "9876500002",
               "Team Alpha", "Haridwar", true);

    Disaster d1(301, "Natural Disaster", "Haridwar", 8);

    Flood f1(302, "Rishikesh", 9, 2.5, 150.0);

    Earthquake e1(303, "Dehradun", 7, 6.2, 10);

    Location l1(401, "Haridwar Railway Station",
                29.9457, 78.1642);

    Node n1(1, "Haridwar");
    Node n2(2, "Rishikesh");

    Road road1(501, &n1, &n2, 20.5, false);

    Graph g1("Haridwar", 5);

    Route route1(601, "Haridwar", "Rishikesh",
                 20.5, 35.0, 92);

    RouteCalculator rc1("Dijkstra Algorithm");

    Shelter s1(701, "Community Shelter", "Haridwar", 500, 250);

    Hospital h1(801, "District Hospital", "Haridwar", 100, 30);

    Ambulance a1(901, "Suresh", "Haridwar", true, 80);

    EmergencyRequest er1(1001, "Amit", "Haridwar",
                         "Medical Emergency", 1, "Pending");

    RescueOperation ro1(1101, "Haridwar",
                        "Team Alpha", 1, "In Progress");

    Resource res1(1201, "Drinking Water", "Essential",
                  1000, "Haridwar Relief Center");

    cout << "====================================\n";
    cout << "       SAHAY DISASTER MANAGEMENT\n";
    cout << "====================================\n";

    p1.displayPerson();
    v1.displayVictim();
    r1.displayRescuer();

    d1.displayDisaster();
    f1.displayFlood();
    e1.displayEarthquake();

    l1.displayLocation();

    cout << "\nRoad Network\n";
    n1.displayNode();
    n2.displayNode();
    road1.displayRoad();

    g1.displayGraph();
    g1.addNode();

    route1.displayRoute();
    rc1.displayCalculator();
    rc1.calculateRoute();

    s1.displayShelter();
    h1.displayHospital();
    a1.displayAmbulance();

    er1.displayRequest();
    ro1.displayOperation();
    res1.displayResource();

    return 0;
}
